<?xml version="1.0" encoding="UTF-8"?>
<!--
  京东黄金 · 模拟交易全权托管 launchd 定时任务模板
  ============================================================
  部署步骤（用户/Agent 按实际环境替换占位符）：
   1) 把 __CLAW__ 换成你的客户端类型（codex / openclaw / joycode …）。
   2) 把 __PROJECT_DIR__ 换成本项目 scripts 的绝对上级目录，
      即 sim_autotrade.py 所在 scripts 目录的父目录绝对路径。
   3) 把 __PYTHON__ 换成 python3 的绝对路径（which python3 查看）。
   4) 如需单日上限，在 ProgramArguments 里加 <string>--daily-cap</string>
      <string>数值</string>；不加则一直托管到余额花完或手动停止。
   5) StartInterval 单位为秒，1800 = 30 分钟轮询一次（通用默认）。

  安装与启停：
   cp scripts/autotrade.launchd.plist ~/Library/LaunchAgents/com.jdgold.autotrade.plist
   launchctl load  ~/Library/LaunchAgents/com.jdgold.autotrade.plist   # 启动
   launchctl unload ~/Library/LaunchAgents/com.jdgold.autotrade.plist   # 停止托管
   launchctl list | grep jdgold                                          # 查看状态

  ⚠️ 外部条件（会导致托管悄悄停止）：
   - 登录授权过期：脚本自动停并通知，需重新登录（人工开浏览器授权）。
   - 关机 / 电池睡眠：launchd 暂停，插电+不关机才稳。
   - 退出 AI 软件：不影响本任务（launchd 是独立系统服务）。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jdgold.autotrade</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__PROJECT_DIR__/scripts/sim_autotrade.py</string>
        <string>--claw</string>
        <string>__CLAW__</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/.joycode/autotrade/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/.joycode/autotrade/launchd.err.log</string>
</dict>
</plist>