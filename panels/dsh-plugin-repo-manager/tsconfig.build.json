{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["src/index.ts"],
  "exclude": ["node_modules", "dist", "src/client", "src/types"]
}
