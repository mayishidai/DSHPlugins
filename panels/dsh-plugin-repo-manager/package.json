{
  "name": "dsh-plugin-repo-manager",
  "version": "1.2.0",
  "description": "DSH web plugin: manage custom plugin repository from settings panel",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client",
    "cordis.patch.yml",
    "manifest.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node generate-client.mjs",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "node generate-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test-isnewer.mjs && node scripts/test-install-update.mjs && node scripts/test-paths.mjs && node scripts/test-sidebar.mjs && node scripts/test-client-parity.mjs && node scripts/test-route-prefix.mjs && node scripts/test-api-e2e.mjs && node scripts/test-esm-safety.mjs && node scripts/test-skills-dir.mjs && node scripts/test-orphans.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "typescript": "^5.0.0"
  }
}
